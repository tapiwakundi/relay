# Expo (optional)
EXPO_ACCESS_TOKEN=
EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_NEON_AUTH_URL=

# Public web
VITE_API_URL=
VITE_LIVEKIT_URL=
