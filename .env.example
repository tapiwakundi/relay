# API
PORT=3001
WEB_ORIGIN=http://localhost:5173

# Better Auth (self-hosted on the API)
# openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public origin of the web app in this environment (Vite in dev)
BETTER_AUTH_URL=http://localhost:5173
# Extra Host values (comma-separated, include port) e.g. relay.example.com,localhost:5173
AUTH_ALLOWED_HOSTS=

# Google OAuth — Web application client
# Google will not accept private LAN IPs (192.168.x.x) as redirect URIs.
# Keep these localhost URIs only:
# Authorized JavaScript origins:
#   http://localhost:5173
#   http://localhost:3001
# Authorized redirect URIs:
#   http://localhost:5173/api/auth/callback/google
#   http://localhost:3001/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Neon (filled by `neon link` / `neon checkout` / `neon deploy` / `neon env pull`)
DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEON_BRANCH=

# Neon Object Storage (AWS-compatible, filled by env pull)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=

# LiveKit huddles (optional — UI still works without media)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Expo (optional — setup:env writes the LAN API URL for the phone)
EXPO_ACCESS_TOKEN=
EXPO_PUBLIC_API_URL=

# Public web (leave empty in local Vite; /api is proxied)
VITE_API_URL=
VITE_LIVEKIT_URL=
