# API
PORT=3001

# Better Auth (self-hosted on the API)
# openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public origin of the API. Desktop and mobile authenticate against this origin.
BETTER_AUTH_URL=http://localhost:3001
# Extra Host values (comma-separated, include port) e.g. relay.example.com
AUTH_ALLOWED_HOSTS=

# Optional override for the packaged desktop app. Defaults to BETTER_AUTH_URL.
RELAY_API_URL=

# Google OAuth — Web application client
# Google will not accept private LAN IPs (192.168.x.x) as redirect URIs.
# The desktop app opens the system browser and returns through
# com.endurancelabs.relaydesktop://auth/callback. Keep the API callback only:
# Authorized JavaScript origins:
#   http://localhost:3001
# Authorized redirect URIs:
#   http://localhost:3001/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Neon (filled by `neon link` / `neon checkout` / `neon deploy` / `neon env pull`)
DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEON_BRANCH=

# Neon Object Storage (AWS-compatible, filled by env pull)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=

# LiveKit huddles (optional — UI still works without media)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Expo (optional — setup:env writes the LAN API URL for the phone)
EXPO_ACCESS_TOKEN=
EXPO_PUBLIC_API_URL=
