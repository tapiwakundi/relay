PORT=3001

# Better Auth (self-hosted on this API)
# openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public origin of this API.
BETTER_AUTH_URL=http://localhost:3001
# Extra Host values (comma-separated, include port) e.g. relay-api-rsck.onrender.com
AUTH_ALLOWED_HOSTS=

# Google OAuth — Web application client
# Authorized JavaScript origins:
#   http://localhost:3001
#   https://relay-api-rsck.onrender.com
# Authorized redirect URIs:
#   http://localhost:3001/api/auth/callback/google
#   https://relay-api-rsck.onrender.com/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Neon (filled by `neon env pull --file apps/api/.env`)
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Neon Object Storage (AWS-compatible, filled by env pull)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=

# LiveKit huddles (optional — UI still works without media)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Expo Push (optional locally, set in production so sends aren't rate-limited)
# Create at https://expo.dev/settings/access-tokens
EXPO_ACCESS_TOKEN=
