# Local `expo run` / simulator / device: copy to .env.local (gitignored).
# `pnpm ios` and `pnpm ios:sim` rewrite this with your Mac's current LAN IP
# so both a physical iPhone and the simulator can reach the API.
EXPO_PUBLIC_API_URL=http://192.168.1.82:3001

# Archives load .env.prod (https://relay-api-rsck.onrender.com).

# Optional. Play Console JSON for non-interactive Android archive uploads.
# GOOGLE_SERVICE_ACCOUNT_KEY_PATH=/absolute/path/to/play-service-account.json
