{
  "expo": {
    "name": "Re8",
    "slug": "relay",
    "owner": "tapiwa.k",
    "version": "0.1.0",
    "buildNumber": 5,
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "relay",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.endurancelabs.relayapp",
      "appleTeamId": "4WUJ6V99Q5",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIApplicationSceneManifest": {
          "UIApplicationSupportsMultipleScenes": false,
          "UISceneConfigurations": {
            "UIWindowSceneSessionRoleApplication": [
              {
                "UISceneConfigurationName": "Default Configuration",
                "UISceneDelegateClassName": "$(PRODUCT_MODULE_NAME).SceneDelegate"
              }
            ]
          }
        },
        "UIBackgroundModes": [
          "audio",
          "voip",
          "remote-notification"
        ],
        "NSPhotoLibraryUsageDescription": "Relay uses your photos for profile pictures and workspace icons.",
        "NSCameraUsageDescription": "Relay uses the camera so you can take a profile photo.",
        "NSMicrophoneUsageDescription": "Relay uses the microphone so you can talk in huddles.",
        "NSLocalNetworkUsageDescription": "Relay uses the local network to reach your computer while developing.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "android": {
      "package": "com.endurancelabs.relayapp",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "RECORD_AUDIO",
        "CAMERA",
        "POST_NOTIFICATIONS",
        "READ_MEDIA_IMAGES"
      ]
    },
    "plugins": [
      "./plugins/withIosMinTarget",
      "./plugins/withIosSceneLifecycle",
      "./plugins/withXcodeEnv",
      [
        "expo-notifications",
        {
          "color": "#1A5FB4",
          "defaultChannel": "default",
          "enableBackgroundRemoteNotifications": true
        }
      ],
      "expo-secure-store",
      "@livekit/react-native-expo-plugin",
      "@config-plugins/react-native-webrtc",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "Relay uses your photos for profile pictures and workspace icons.",
          "cameraPermission": "Relay uses the camera so you can take a profile photo."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "1908791e-bfaf-4cb7-b739-702e149d50e7"
      }
    }
  }
}
