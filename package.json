{
  "name": "relay",
  "private": true,
  "version": "0.1.0",
  "description": "Relay — a Slack-style workspace messenger",
  "scripts": {
    "dev": "pnpm --filter @relay/api --filter @relay/web --parallel dev",
    "dev:api": "pnpm --filter @relay/api dev",
    "dev:web": "pnpm --filter @relay/web dev",
    "dev:desktop": "pnpm --filter @relay/desktop dev",
    "dev:mobile": "pnpm --filter @relay/mobile ios",
    "dev:mobile:sim": "pnpm --filter @relay/mobile ios:sim",
    "build": "pnpm --filter @relay/shared build && pnpm --filter @relay/api build && pnpm --filter @relay/web build",
    "db:generate": "pnpm --filter @relay/api db:generate",
    "db:migrate": "pnpm --filter @relay/api db:migrate",
    "db:push": "pnpm --filter @relay/api db:push"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.14.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "electron"
    ]
  },
  "dependencies": {
    "@neon/config": "^1.7.2",
    "@neon/env": "^1.4.3"
  }
}
